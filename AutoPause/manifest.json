{
  "manifest_version": 3,
  "name": "YouTube Focus Manager",
  "version": "1.0",
  "description": "Automatically pause YouTube videos when switching away and resume when returning",
  
  "permissions": [
    "tabs",
    "activeTab"
  ],

  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],

  "background": {
    "service_worker": "service-worker.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_title": "YouTube Focus Manager"
  }
}
